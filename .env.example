# Copy this file to .env and fill in your values, then:  docker compose up --build -d
# .env is gitignored — never commit real secrets.
#
# REQUIRED for docker compose (prod profile is fail-fast: missing vars abort startup):
#
# Shared PostgreSQL password for the three per-service databases
DB_PASSWORD=change_me_to_something_long_and_random
#
# JWT signing key — min 32 bytes (256 bits) for HS256. Generate with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_64_char_random_secret_for_local_compose_only_1234
#
# AWS S3 access for product image uploads (real values needed for uploads to work)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
#
# OPTIONAL (sane compose defaults already set in docker-compose.yml):
# GRAFANA_PASSWORD=admin
#
# ---------------------------------------------------------------------------
# The variables below are ONLY for running services bare-metal (./mvnw ...).
# docker compose sets container-internal values itself (e.g. DB_URL per service,
# EUREKA_URL=http://service-discovery:8761/eureka, ZIPKIN_URL=http://zipkin:...).
DB_URL=jdbc:postgresql://localhost:5432/user_db
DB_USERNAME=postgres
EUREKA_URL=http://localhost:8761/eureka
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
